# 测试环境（*.wnbgj.com）变量模板。
#
# 用法：
#   cp infra/test-env/.env.test.example .env.test
#   # 改掉下面所有 REPLACE_ME_*，然后：
#   docker compose --env-file .env.test -f infra/test-env/docker-compose.yml up -d migrate api web quote
#
# 只有本文件里的 TEST_* 变量参与替代；容器内的 NODE_ENV / AUTH_MODE / WEAVE_ENV
# 由 docker-compose.yml 固定，不要在这里覆盖（覆盖会让测试环境与生产不再同构）。
#   NODE_ENV=production  AUTH_MODE=oidc  WEAVE_ENV=test
#
# 这里不允许出现任何真实密钥：REPLACE_ME_* 必须替换，否则等于把演示凭据写进仓库。

# 与生产同 tag 的镜像。测试通过后发布生产 = 同一个 tag 换 env 换库。
WEAVE_IMAGE=sjzsdu/weave-order:REPLACE_ME_TAG

# 独立数据库（不要指向生产实例）。APP_DATABASE_URL 必须是 NOBYPASSRLS 的 weave_app 角色。
TEST_DATABASE_URL=postgres://weave:REPLACE_ME@pg-test.wnbgj.com:5432/weave_order_test
TEST_APP_DATABASE_URL=postgres://weave_app:REPLACE_ME@pg-test.wnbgj.com:5432/weave_order_test
TEST_REDIS_URL=redis://:REPLACE_ME@redis-test.wnbgj.com:6379/0

# 测试 Casdoor 实例与内部用户池。
TEST_CASDOOR_ISSUER=https://casdoor-test.wnbgj.com
TEST_CASDOOR_AUDIENCE=weave-order
TEST_CASDOOR_JWKS_URI=https://casdoor-test.wnbgj.com/.well-known/jwks

# 对外地址（决定分享链接与 Cookie 域）。
TEST_WEB_APP_URL=https://weave-test.wnbgj.com
TEST_PUBLIC_APP_URL=https://quote-test.wnbgj.com
TEST_PLATFORM_API_URL=https://platform-test.wnbgj.com

# 独立对象存储桶，不要与生产共用 bucket。
TEST_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
TEST_S3_REGION=ap-guangzhou
TEST_S3_BUCKET=weave-order-test
TEST_S3_ACCESS_KEY_ID=REPLACE_ME
TEST_S3_SECRET_ACCESS_KEY=REPLACE_ME

# 通知走真实链路，收件人是内部同事。
TEST_NOTIFY_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
TEST_NOTIFY_TOKEN=REPLACE_ME

# 服务端密钥，生成方式：openssl rand -hex 32
TEST_QUOTE_SHARE_SECRET=REPLACE_ME
TEST_PERSONAL_TOKEN_PEPPER=REPLACE_ME
TEST_PRINT_AGENT_SECRET=REPLACE_ME
TEST_ONBOARDING_SECRET=REPLACE_ME

# 演示租户（与 seed 口径一致；默认值可留空不写）。
TEST_SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
TEST_SEED_ORG=weave-test

# demo:reset 在测试环境（生产态 + WEAVE_ENV=test）还需要一道显式确认，
# 不写在这里，而是执行时带上：
#   DEMO_RESET_CONFIRM=1 docker compose --env-file .env.test \
#     -f infra/test-env/docker-compose.yml run --rm demo-reset
# 目的：即使把 .env.test 拷错到生产，单靠 WEAVE_ENV=test 也清不掉库。
