coverage/
# Astro 生成的类型与内容集合缓存（apps/site）
.astro/
.env
.env.*
!.env.example
# 任何 `.env.<名字>.example` 都是可提交的模板（infra/test-env 等），
# 其余 `.env.*` 仍然忽略。WAN-137 教训：只放行 `.env.example` 会让
# `infra/test-env/.env.test.example` 只在本地存在，干净检出直接失败。
!**/.env.*.example
*.log
.DS_Store
.next/

# Taro / SWC 构建缓存
.swc/
.taro/

# TypeScript incremental build cache
*.tsbuildinfo

# vitest JSON 报告（CI 打印用例守卫的输入）
test-results/

# Rust / Tauri 构建产物与自动生成文件
**/gen/schemas/

# Python 缓存（品牌生成脚本 brand/tools）
__pycache__/
*.pyc

# 本地对象存储（scripts/dev-storage-up.sh 的二进制/数据/日志）
.dev-storage/

# WorkBuddy 工作区数据（项目记忆与日志，不入库）
.workbuddy/

# Playwright（截图 / trace / HTML 报告 / 种子清单）
e2e/.artifacts/
