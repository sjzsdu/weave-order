---
import BaseLayout from "../layouts/BaseLayout.astro";
import jsonLd from "../data/jsonld/pricing.ts";

const title = "价格与套餐 · 织序 WeaveOrder";
const description =
  "织序按公司订阅：基础 ¥299 / 月、专业 ¥899 / 月、企业 ¥2,999 起，含固定账号数与每月 AI credits。不按人头、不按模型调用单价收费。价格、超额规则与合同条款一次说清。";
const ogDescription = "按公司订阅，含账号数与 AI credits。基础 ¥299 / 月、专业 ¥899 / 月。";
---

<BaseLayout
  title={title}
  description={description}
  canonical="/pricing.html"
  jsonLd={jsonLd}
  ogDescription={ogDescription}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <div>
          <p class="eyebrow">价格</p>
          <h1>
            按公司订阅，
            <br />
            <em>用多少 AI 算多少</em>。
          </h1>
          <p class="lede">
            不按人头算，也不看模型账单。选一个月费套餐，含固定账号数和每月 credits；AI
            用超了就暂停智能体，人可以继续看、继续批、继续导出。年付相当于送两个月。
          </p>
        </div>
        <div class="page-hero__aside">
          <p>
            <b>3 天</b>全功能试用，不需要付费信息
          </p>
          <p>
            <b>1 分钟</b>创建公司，不用等审核
          </p>
          <p>
            <b>随时</b>导出客户、样品、报价与单据
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(40px,5vw,64px)">
    <div class="container">
      <div class="plans">
        <article class="plan">
          <h3>基础</h3>
          <p class="plan__desc">先把报价和寄样跑顺。适合 3 到 5 人的小团队。</p>
          <div class="plan__price">
            ¥299<small>/ 月</small>
          </div>
          <ul class="plan__list">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              含 5 个账号
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              每月 20,000 credits（≈2,000 次报价）
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              找样、报价、客户三个能力
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Excel / CSV 导入、客户报价链接
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              手机拍照派活、离线补交
            </li>
          </ul>
          <div class="plan__foot">
            <a
              class="btn btn--ghost"
              href="signup.html?plan=basic"
              data-cta="pricing-card"
              data-cta-label="基础套餐"
            >
              开始 3 天试用
            </a>
            <p class="plan__fine">年付 ¥2,990（省 2 个月）</p>
          </div>
        </article>

        <article class="plan plan--featured">
          <span class="plan__badge">多数团队选这个</span>
          <h3>专业</h3>
          <p class="plan__desc">六个智能体全部上线，从找样到回款一条链路跑完。</p>
          <div class="plan__price">
            ¥899<small>/ 月</small>
          </div>
          <ul class="plan__list">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              含 20 个账号
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              每月 100,000 credits（≈10,000 次报价）
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              六个智能体 + 客户上下文
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              订单交期、对账回款、打印单证
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              自然语言问数、命令行接入
            </li>
          </ul>
          <div class="plan__foot">
            <a
              class="btn btn--primary"
              href="signup.html?plan=pro"
              data-cta="pricing-card"
              data-cta-label="专业套餐"
            >
              开始 3 天试用
            </a>
            <p class="plan__fine">年付 ¥8,990（省 2 个月）</p>
          </div>
        </article>

        <article class="plan">
          <h3>企业</h3>
          <p class="plan__desc">集团多组织、独立数据库、自有登录与私有化部署。</p>
          <div class="plan__price">
            ¥2,999<small>/ 月起</small>
          </div>
          <ul class="plan__list">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              含 50 个账号起，可扩
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              每月 500,000 credits 起
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              独立数据库 / 私有化
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              对接企业已有登录与组织架构
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              专属陪跑、SLA 与数据保留期
            </li>
          </ul>
          <div class="plan__foot">
            <a
              class="btn btn--ghost"
              href="signup.html?plan=enterprise"
              data-cta="pricing-card"
              data-cta-label="定制套餐"
            >
              联系我们
            </a>
            <p class="plan__fine">按合同，年付为主</p>
          </div>
        </article>
      </div>
      <p class="pricing__note">
        价格含税，可开增值税普通发票或专用发票。不按人头、不按打印张数、不按模型调用
        单价收费；按公司订阅，含固定账号数与每月 credits。
      </p>
    </div>
  </section>

  <section
    class="section"
    id="billing-rules"
    style="background:var(--paper-deep);border-block:1px solid var(--line)"
  >
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">计费规则</p>
          <h2>
            钱怎么算，
            <br />
            一次说清。
          </h2>
        </div>
        <p class="lede">
          没有隐藏项，也不会按模型调用实时扣费。你付的是公司套餐和每月
          credits，快用完时会在设置页提醒你，不自动扣费。
        </p>
      </div>

      <div class="table-wrap">
        <table class="price-table">
          <caption class="muted" style="text-align:left;padding:12px 14px;font-size:12px">
            以下为不含税口径，最终以合同为准。
          </caption>
          <thead>
            <tr>
              <th scope="col">项目</th>
              <th scope="col">怎么算</th>
              <th scope="col">说明</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>套餐月费</td>
              <td>按公司收，一个价，不看人数</td>
              <td>基础 ¥299、专业 ¥899、企业 ¥2,999 起；不按人头加钱，账号数在套餐里</td>
            </tr>
            <tr>
              <td>账号数</td>
              <td>套餐内含固定账号数</td>
              <td>基础 5 个、专业 20 个、企业 50 个起；不够就升级套餐，不单独卖座位</td>
            </tr>
            <tr>
              <td>AI credits</td>
              <td>AI 用量额度，1 credit 约等于 1,000 个词的处理量（读 + 写）</td>
              <td>基础 20,000、专业 100,000、企业 500,000 起；每月 1 日重置，不结转</td>
            </tr>
            <tr>
              <td>用超了</td>
              <td>暂停智能体，不自动扣费</td>
              <td>
                80% 在设置页提醒；100% 智能体停止接新活，人仍可查看、审批、导出；充值或升级立刻恢复
              </td>
            </tr>
            <tr>
              <td>加油包</td>
              <td>¥99 / 10,000 credits（找对接人充值）</td>
              <td>当月有效，随订阅走；不自动购买，需要你确认</td>
            </tr>
            <tr>
              <td>试用</td>
              <td>3 天，全功能</td>
              <td>
                含 2,000 credits、最多 3 个账号；不需要付费信息，到期前 1 天提醒，不自动转付费
              </td>
            </tr>
            <tr>
              <td>年付</td>
              <td>10 个月价用 12 个月</td>
              <td>基础 ¥2,990 / 年、专业 ¥8,990 / 年；企业按合同</td>
            </tr>
            <tr>
              <td>发票</td>
              <td>增值税普通发票 / 专用发票</td>
              <td>付款后 3 个工作日内开具，电子票发到你留的邮箱</td>
            </tr>
            <tr>
              <td>存储</td>
              <td>基础 50 GB、专业 200 GB</td>
              <td>样品图与单据 PDF 都算；超出按 ¥1 / GB / 月，可随时导出后清理</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">常见问题</p>
          <h2>买之前你最想确认的。</h2>
        </div>
        <p class="lede">
          还有别的疑问，直接写信到{" "}
          <a
            href="mailto:hello@weaveorder.cn"
            style="color:inherit;text-decoration:underline;text-underline-offset:3px"
          >
            hello@weaveorder.cn
          </a>
          ，工作日 4 小时内回复。
        </p>
      </div>
      <div class="faq">
        <details open>
          <summary>试用到期后数据还在吗？</summary>
          <p>
            在。到期后账号进入只读状态 30 天，你可以导出全部数据或联系我们转正付费；30
            天后转休眠，保留 90 天可恢复。
          </p>
        </details>
        <details>
          <summary>我们只有 2 个人，能买基础版吗？</summary>
          <p>
            可以。基础版含 5 个账号、¥299 /
            月，两个人用绰绰有余，空着的账号不额外收费，以后同事进来直接用。
          </p>
        </details>
        <details>
          <summary>为什么不按人头收费？</summary>
          <p>
            按人头收费会逼你在「多拉一个人」时先算钱。我们按公司收固定月费，账号数包含在套餐里；真正变动的是
            AI 用量（credits），那部分按量给足、超了提醒，不自动扣费。
          </p>
        </details>
        <details>
          <summary>可以开发票吗？能对公转账吗？</summary>
          <p>
            可以开增值税普通发票和专用发票，支持对公转账。付款后 3
            个工作日内开票，电子票发到你留的邮箱。
          </p>
        </details>
        <details>
          <summary>私有化部署怎么报价？</summary>
          <p>
            按年度合同报价，取决于组织数量、隔离方式（独立库 /
            私有化）、是否需要对接统一登录。列表价 ¥2,999 / 月起，先做一次 30
            分钟需求确认，再给方案与报价。
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="container">
      <div class="cta__grid">
        <div>
          <p class="eyebrow eyebrow--light">下一步</p>
          <h2>
            开通只要三步，
            <br />
            今天就能跑一单。
          </h2>
          <p class="lede">
            登记公司和联系人 → 我们当天开好你的企业空间 → 你收到登录链接，导入客户和样品即可开始。
          </p>
          <ul class="cta__list">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              不绑卡、不需要 IT 配合
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              我们替你把 Excel 客户表和样品表导进去
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 13l4 4 10-10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              第一周只看一个指标：报价从几小时变成几分钟
            </li>
          </ul>
        </div>
        <div
          class="note-box"
          style="background:rgba(247,244,238,.06);border-color:rgba(247,244,238,.16);color:rgba(247,244,238,.78)"
        >
          <p style="margin:0 0 16px;color:#f7f4ee;font-family:var(--font-serif);font-size:19px;font-weight:700">
            开通与咨询
          </p>
          <p style="margin:0 0 14px">
            登录后填个公司名就能创建，几秒建好，试用期 3 天。也可以先约 20
            分钟演示，用你自己的客户数据跑一张报价草稿。
          </p>
          <p style="margin:0 0 20px;font-size:12.5px;color:rgba(247,244,238,.55)">
            邮箱{" "}
            <a
              href="mailto:hello@weaveorder.cn"
              style="color:inherit;text-decoration:underline;text-underline-offset:3px"
            >
              hello@weaveorder.cn
            </a>{" "}
            · 工作日 9:00–18:00
          </p>
          <a class="btn btn--light" href="signup.html" data-cta="pricing-cta" style="width:100%">
            登记开通
          </a>
          <a
            class="btn btn--outline-light"
            href="index.html#demo"
            data-cta="pricing-cta"
            style="width:100%;margin-top:10px"
          >
            先看演示
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
