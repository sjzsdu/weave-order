---
import BaseLayout from "../layouts/BaseLayout.astro";
import jsonLd from "../data/jsonld/download.ts";

const title = "下载与安装 · 织序 WeaveOrder（网页版 / Windows / macOS / 手机 / 打印代理）";
const description =
  "织序有网页版、Windows 与 macOS 桌面版、手机网页版（PWA）与打印代理。网页版免安装，打开即可用；桌面版与打印代理内测中，登记后发放安装包。";
const ogTitle = "下载与安装 · 织序 WeaveOrder";
const ogDescription = "网页版免安装；Windows / macOS 桌面版与打印代理内测中；手机浏览器即可使用。";
---

<BaseLayout
  title={title}
  description={description}
  canonical="/download.html"
  jsonLd={jsonLd}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <div>
          <p class="eyebrow">下载</p>
          <h1>
            不用装也能用，
            <br />
            <em>装了更顺手</em>。
          </h1>
          <p class="lede">
            网页版打开即用，手机上添加到主屏幕后就是 App。Windows 与 macOS
            桌面版给了快捷键、离线队列和打印代理，适合每天要出单据的岗位。
          </p>
        </div>
        <div class="page-hero__aside">
          <p id="platformHint">
            <b>推荐</b>先试网页版，3 秒进入工作台
          </p>
          <p>
            <b>桌面包</b>内测发放，登记后 1 个工作日内发出
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-block:clamp(36px,4.5vw,60px)">
    <div class="container">
      <div class="download-grid">
        <article class="dl-card" data-platform="网页版">
          <div class="dl-card__top">
            <span class="dl-card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path
                  d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"
                  stroke-linecap="round"
                />
              </svg>
            </span>
            <h3>网页版</h3>
          </div>
          <p>
            免安装，浏览器打开即用。Windows、macOS、国产系统都支持，换电脑不用重装，登录后数据都在。
          </p>
          <div class="dl-card__meta">
            <span>支持 Chrome / Edge / Safari 近两年版本</span>
            <span>推荐分辨率 1366 × 768 以上</span>
          </div>
          <a class="btn btn--primary" href="https://weave.wnbgj.com" rel="noopener">
            打开工作台
          </a>
        </article>

        <article class="dl-card" data-platform="windows">
          <div class="dl-card__top">
            <span class="dl-card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path
                  d="M4 4.5l7-1v7H4zM12 3.4l8-1.1v8.2h-8zM4 11.5h7v7l-7-1zM12 11.5h8v8.2l-8-1.1z"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <h3>Windows 桌面版</h3>
          </div>
          <p>
            带全局快捷键、离线队列与打印代理。断网时扫码入库、拍照派活先存本地，恢复后自动补交。
          </p>
          <div class="dl-card__meta">
            <span>Windows 10 / 11 · 64 位</span>
            <span>内测中 · 登记后发送安装包</span>
          </div>
          <a class="btn btn--ghost" href="signup.html?plan=desktop">
            登记获取安装包
          </a>
        </article>

        <article class="dl-card" data-platform="macos">
          <div class="dl-card__top">
            <span class="dl-card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <rect x="2.5" y="4" width="19" height="12" rx="1.6" />
                <path d="M8 20h8M12 16v4" stroke-linecap="round" />
              </svg>
            </span>
            <h3>macOS 桌面版</h3>
          </div>
          <p>
            与 Windows 版功能一致，适配 Apple 芯片与 Intel 机型。适合设计、打样和需要看图的岗位。
          </p>
          <div class="dl-card__meta">
            <span>macOS 12 及以上</span>
            <span>内测中 · 登记后发送安装包</span>
          </div>
          <a class="btn btn--ghost" href="signup.html?plan=desktop">
            登记获取安装包
          </a>
        </article>

        <article class="dl-card" data-platform="手机">
          <div class="dl-card__top">
            <span class="dl-card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
                <path d="M10.5 19h3" stroke-linecap="round" />
              </svg>
            </span>
            <h3>手机版（PWA）</h3>
          </div>
          <p>
            手机浏览器打开后点「添加到主屏幕」，图标和 App
            一样。现场拍样布、扫码出入库、语音派活、车上批单。
          </p>
          <div class="dl-card__meta">
            <span>iPhone / Android 浏览器</span>
            <span>无需应用商店，不占额外空间</span>
          </div>
          <a class="btn btn--ghost" href="https://weave.wnbgj.com" rel="noopener">
            手机打开
          </a>
        </article>

        <article class="dl-card" data-platform="打印代理">
          <div class="dl-card__top">
            <span class="dl-card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="M7 8V3h10v5" stroke-linejoin="round" />
                <rect x="3" y="8" width="18" height="8" rx="1.5" />
                <path d="M7 14h10v7H7z" stroke-linejoin="round" />
              </svg>
            </span>
            <h3>打印代理</h3>
          </div>
          <p>
            箱唛、发货单、拣货单直接下到本地标签机与针式打印机。支持 ZPL /
            TSPL，扫码重打，每张纸都有日志。
          </p>
          <div class="dl-card__meta">
            <span>随桌面版一起安装</span>
            <span>Zebra / TSC / 佳博等主流机型</span>
          </div>
          <a class="btn btn--ghost" href="docs/printing.html">
            查看支持机型
          </a>
        </article>

        <article class="dl-card dl-card--muted" data-platform="命令行">
          <div class="dl-card__top">
            <span class="dl-card__icon" style="background:var(--paper-deep);color:var(--ink-700)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M7 10l3 2-3 2M13 14h4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3>命令行与智能体接入</h3>
          </div>
          <p>
            让 codex、Claude Code
            等智能体直接操作织序：查询客户、起草报价、拉审批列表。源码开放，内测期间按文档从仓库构建。
          </p>
          <div class="dl-card__meta">
            <span>Node 20+ · 当前 v0.1.0</span>
            <span>npm 包尚未公开发布</span>
          </div>
          <a class="btn btn--ghost" href="docs/agent.html">
            看接入文档
          </a>
        </article>
      </div>

      <div class="note-box" style="margin-top:28px">
        <b>为什么桌面版还在内测？</b>{" "}
        桌面版需要接打印机、扫码枪和电子秤，不同品牌机型的兼容性要一台台验。我们不希望把没验过的安装包放出来让你踩坑：登记后我们会先问清你的机型，再把对应版本发给你。
      </div>
    </div>
  </section>

  <section
    class="section"
    id="requirements"
    style="background:var(--paper-deep);border-block:1px solid var(--line)"
  >
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">运行环境</p>
          <h2>你的电脑跑得动。</h2>
        </div>
        <p class="lede">
          织序不是重客户端。网页版对设备几乎没有要求，桌面版多出来的只是打印与离线能力。
        </p>
      </div>
      <div class="table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th scope="col">形态</th>
              <th scope="col">最低配置</th>
              <th scope="col">说明</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>网页版</td>
              <td>Chrome / Edge / Safari 近两年版本，2 GB 内存</td>
              <td>不需要安装，登录后直接进工作台；打印需要桌面版或浏览器打印</td>
            </tr>
            <tr>
              <td>Windows 桌面版</td>
              <td>Windows 10 64 位，4 GB 内存，300 MB 磁盘</td>
              <td>含打印代理；支持离线队列</td>
            </tr>
            <tr>
              <td>macOS 桌面版</td>
              <td>macOS 12，Apple 芯片或 Intel</td>
              <td>含打印代理；适合打样与看图</td>
            </tr>
            <tr>
              <td>手机</td>
              <td>iOS 15 / Android 9 以上浏览器</td>
              <td>添加到主屏幕即可全屏使用；拍照与扫码直接调系统相机</td>
            </tr>
            <tr>
              <td>打印代理</td>
              <td>USB 或网络连接的标签机 / 针式打印机</td>
              <td>
                ZPL、TSPL、ESC/POS；具体机型见<a href="docs/printing.html">打印文档</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">安装之后</p>
          <h2>三步进到工作台。</h2>
        </div>
        <p class="lede">第一次打开会引导你完成这三件事，全程不超过 10 分钟。</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step__dot">1</div>
          <p class="step__tag">1 分钟</p>
          <h3>登录</h3>
          <p>用公司给你的账号登录，或让老板在后台邀请你。不需要记额外密码。</p>
        </div>
        <div class="step">
          <div class="step__dot">2</div>
          <p class="step__tag">5 分钟</p>
          <h3>导入客户与样品</h3>
          <p>把现有的 Excel 直接拖进来，我们逐行检查，有问题的行会告诉你哪一列不对。</p>
        </div>
        <div class="step step--human">
          <div class="step__dot">3</div>
          <p class="step__tag">3 分钟</p>
          <h3>派第一件活</h3>
          <p>把客户刚发来的那句话贴进去，看着它找样、核价、出草稿，你只点一次批准。</p>
        </div>
      </div>
      <p style="margin-top:26px;font-size:14px;color:var(--ink-500)">
        卡在某一步？
        <a
          href="docs/quickstart.html"
          style="color:var(--indigo);text-decoration:underline;text-underline-offset:3px"
        >
          看 5 分钟上手指南
        </a>
        ，或写信到{" "}
        <a
          href="mailto:hello@weaveorder.cn"
          style="color:inherit;text-decoration:underline;text-underline-offset:3px"
        >
          hello@weaveorder.cn
        </a>
        。
      </p>
    </div>
  </section>
</BaseLayout>
