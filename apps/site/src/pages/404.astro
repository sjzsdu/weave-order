---
import BaseLayout from "../layouts/BaseLayout.astro";
import { app } from "../lib/site";

const title = "页面没有找到 · 织序 WeaveOrder";
const description = "这个地址没有对应的页面。回到官网首页、帮助中心，或直接登录工作台。";
const robots = "noindex,follow";
---

<BaseLayout title={title} description={description} bare robots={robots}>
  <div class="container auth-wrap" style="min-height:70vh">
    <div class="auth-card" style="text-align:left">
      <div class="auth-card__brand">
        <img src="assets/logo-mark.svg" alt="" width="32" height="32" />
        <span>织序 WeaveOrder</span>
      </div>
      <p class="eyebrow">404</p>
      <h1>这个地址没有内容</h1>
      <p class="auth-card__sub">
        可能是链接写错了，也可能这一页已经搬到帮助中心。下面几个入口通常能带你到想去的地方。
      </p>
      <div class="auth-alt">
        <a href="index.html">
          <span>官网首页</span>
          <small>产品与能力</small>
        </a>
        <a href="docs/index.html">
          <span>帮助中心</span>
          <small>上手、导入、审批、打印</small>
        </a>
        <a href={`${app}/`} data-login="site-404">
          <span>进入工作台</span>
          <small>内部同事</small>
        </a>
        <a href="signup.html">
          <span>免费试用</span>
          <small>3 天，当天开通</small>
        </a>
      </div>
      <p class="auth-note">
        找不到想要的内容？写信到 <a href="mailto:hello@weaveorder.cn">hello@weaveorder.cn</a>
        ，我们补上。
      </p>
    </div>
  </div>
</BaseLayout>
