{
  "name": "@weave-order/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 后端（确定性内核 / 工具接口层 / 智能体编排 / 审批队列）",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src scripts test",
    "demo": "tsx scripts/demo-kernel.ts",
    "demo:followup": "tsx scripts/demo-followup.ts",
    "demo:quote": "tsx scripts/demo-quote.ts",
    "seed": "tsx scripts/import-data.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@weave-order/db": "workspace:*",
    "@weave-order/schema": "workspace:*",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^5.8.1",
    "jose": "^5.10.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
