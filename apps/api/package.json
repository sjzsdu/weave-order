{
  "name": "@weave-order/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 后端（确定性内核 / 工具接口层 / 智能体编排 / 审批队列）",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "test:print:guard": "tsx scripts/assert-print-tests.ts test-results/vitest.json",
    "lint": "eslint src scripts test",
    "demo": "tsx scripts/demo-kernel.ts",
    "demo:followup": "tsx scripts/demo-followup.ts",
    "demo:quote": "tsx scripts/demo-quote.ts",
    "demo:scenes": "tsx scripts/demo-scenes.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "seed": "tsx scripts/import-data.ts",
    "seed:persona": "tsx scripts/seed-persona-fixture.ts",
    "backfill:owner": "tsx scripts/backfill-owner.ts",
    "backfill:weight-gsm": "tsx scripts/backfill-weight-gsm.ts",
    "control:sync": "tsx scripts/control-sync.ts",
    "control:reconcile": "tsx scripts/control-reconcile.ts",
    "reindex:samples": "tsx scripts/reindex-samples.ts",
    "reindex:images": "tsx scripts/reindex-images.ts",
    "verify:image-search": "tsx scripts/verify-image-search.ts",
    "verify:prod-env": "vitest run test/production-env-gate.test.ts",
    "maintain:media": "tsx scripts/maintain-media.ts",
    "maintain:inbound": "tsx scripts/maintain-inbound.ts",
    "verify:thumbnails": "tsx scripts/verify-thumbnails.ts",
    "verify:sample-card": "tsx scripts/verify-sample-card.ts",
    "maintain:audit": "tsx scripts/maintain-audit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@langchain/core": "^1.4.2",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@weave-order/db": "workspace:*",
    "@weave-order/notify": "workspace:*",
    "@weave-order/schema": "workspace:*",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
