{
  "name": "@weave-order/platform-api",
  "version": "0.0.0",
  "private": true,
  "description": "E4 平台总管理端后端（控制面：租户/订阅/用量/账单/审批/审计，独立数据库）",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test scripts",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@weave-order/schema": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.10.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76",
    "@weave-order/control-db": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
