{
  "name": "@weave-order/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "E2 移动端（Taro 一套代码：H5/PWA + 小程序 + RN App）",
  "scripts": {
    "build": "taro build --type h5 && node scripts/check-prod-bundle.mjs",
    "build:demo": "TARO_APP_MOCK=1 NODE_ENV=development taro build --type h5",
    "dev": "TARO_APP_MOCK=1 taro build --type h5 --watch",
    "dev:h5": "TARO_APP_MOCK=1 taro build --type h5 --watch",
    "dev:live": "taro build --type h5 --watch",
    "build:weapp": "TARO_APP_OUTPUT=dist/weapp taro build --type weapp && node scripts/check-prod-bundle.mjs",
    "dev:weapp": "TARO_APP_OUTPUT=dist/weapp TARO_APP_MOCK=1 taro build --type weapp --watch",
    "verify:mock-gate": "TARO_APP_OUTPUT=dist-gate TARO_APP_MOCK=1 NODE_ENV=development taro build --type h5 >/dev/null && ! TARO_APP_OUTPUT=dist-gate node scripts/check-prod-bundle.mjs",
    "build:tabbar-icons": "node scripts/build-tabbar-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "node ../../scripts/lint.mjs mobile"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@tanstack/react-query": "^5.108.1",
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "@weave-order/core": "workspace:*",
    "@weave-order/schema": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tarojs/cli": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.8",
    "babel-preset-taro": "4.3.3",
    "react-refresh": "^0.19.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "webpack": "5.91.0"
  }
}
