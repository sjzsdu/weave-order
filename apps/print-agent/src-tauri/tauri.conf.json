{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "织序打印代理",
  "version": "0.1.0",
  "identifier": "cn.weaveorder.print-agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "织序打印代理",
        "width": 820,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://print.weaveorder.cn/agent/latest.json"],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
