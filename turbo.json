{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "PORT",
    "AUTH_MODE",
    "CASDOOR_ISSUER",
    "CASDOOR_AUDIENCE",
    "CASDOOR_JWKS_URI",
    "PUBLIC_APP_URL",
    "MEDIA_ALLOWED_HOSTS",
    "MEDIA_MAX_BYTES",
    "LLM_PROVIDER",
    "LITELLM_BASE_URL",
    "LITELLM_MASTER_KEY",
    "LITELLM_TIMEOUT_MS",
    "IMPORT_XLSX",
    "IMPORT_CUSTOMERS",
    "IMPORT_SAMPLES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "demo": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "demo:followup": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "demo:quote": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
