{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "PORT",
    "IMPORT_XLSX",
    "IMPORT_CUSTOMERS",
    "IMPORT_SAMPLES",
    "WEAVE_COMPANY_NAME",
    "WEAVE_COMPANY_ADDRESS",
    "WEAVE_COMPANY_PHONE",
    "WEAVE_COMPANY_EMAIL",
    "WEAVE_QUOTE_TERMS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "demo": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "demo:followup": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
