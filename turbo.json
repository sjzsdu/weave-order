{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "PORT",
    "IMPORT_XLSX",
    "IMPORT_CUSTOMERS",
    "IMPORT_SAMPLES",
    "PUBLIC_API_URL",
    "AUTH_TOKEN_PEPPER",
    "AUTH_REQUIRED",
    "DEVICE_CODE_TTL_SECONDS",
    "DEVICE_POLL_INTERVAL_SECONDS",
    "WEAVE_SERVER",
    "WEAVE_TOKEN",
    "WEAVE_CONFIG_DIR",
    "WEAVE_SKILL_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "demo": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "demo:followup": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
