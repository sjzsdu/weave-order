# syntax=docker/dockerfile:1

# 织序 Web 镜像（React + Vite 静态产物 + Nginx 网关）。
#
# 前端只调相对路径 /api/*（apps/web/src/api.ts），所以生产环境由这里的 Nginx
# 同源转发到 API 容器，不需要 CORS，也不需要在前端注入 API 地址。
# Nginx 配置写在 Dockerfile 里，是为了守住本任务的改动边界（不新增仓库内配置文件）。

FROM node:22-alpine AS base
# 版本必须与根 package.json 的 packageManager 字段一致。
RUN corepack enable && corepack prepare pnpm@10.34.9 --activate
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
WORKDIR /app

FROM base AS manifest
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/schema/package.json packages/schema/
COPY packages/shared/package.json packages/shared/

FROM manifest AS builder
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @weave-order/web...
COPY tsconfig.base.json ./
COPY packages/schema ./packages/schema
COPY apps/web ./apps/web
# schema 的 d.ts 是前端类型检查的输入，先构建它再构建 web。
RUN pnpm --filter @weave-order/web... build

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # 以图搜图的 base64 请求体，与 API 侧 10mb 上限对齐。
  client_max_body_size 10m;

  location /api/ {
    proxy_pass http://api:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # 三个窗口都是单页应用，刷新任意路由都回 index.html。
  location / {
    try_files $uri $uri/ /index.html;
  }
}
NGINX

EXPOSE 80
