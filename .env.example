# 本地默认值与 docker-compose.yml 一致；不需要 .env 也能跑。
# 需要覆盖时：cp .env.example .env
DATABASE_URL=postgres://weave:weave@localhost:5433/weave_order
# 网关业务连接：生产/OIDC 模式必填，必须用 weave_app（NOSUPERUSER / NOBYPASSRLS）；
# 缺省会拒绝启动。启动时还会断言当前角色不是 superuser / bypassrls。
# 本地 dev 不设则沿用 DATABASE_URL（owner），仅用于开发并打印告警。
# APP_DATABASE_URL=postgres://weave_app:weave_app@localhost:5433/weave_order
REDIS_URL=redis://localhost:6380
# embedding：local-stub 无需外部 key；真实 provider 接入后在此切换
EMBEDDING_PROVIDER=local-stub
# 智能体 providers（默认本地确定性实现，无需任何外部 key）
# litellm = 经 LiteLLM 网关调用真实模型（token 自动计量）；local-rule = 零 key 规则实现
LLM_PROVIDER=local-rule
LOGISTICS_PROVIDER=local-deterministic
REPLY_SOURCE=local-scripted
PORT=3000
NODE_ENV=development
# 鉴权：dev = 接受 `Bearer dev:<sub>:<org>`（仅本地）；oidc = Casdoor JWKS 验签。
# 生产环境必须 AUTH_MODE=oidc，否则进程拒绝启动。
AUTH_MODE=dev
CASDOOR_ISSUER=https://sso.wnbgj.com
CASDOOR_AUDIENCE=weave-order
# CASDOOR_JWKS_URI=https://sso.wnbgj.com/.well-known/jwks
# 客户报价分享链接的站点根地址（E3，Next.js 客户页，本地 5174）
PUBLIC_APP_URL=http://localhost:5174
# 报价链接 HMAC 密钥：生产必须换成 ≥32 字节随机值（openssl rand -hex 32）。
# 轮换会让所有已发出的链接立即失效。
QUOTE_SHARE_SECRET=dev-only-quote-share-secret-change-me-0001
# Next.js 客户页读取 API 的地址（服务端 SSR 用 QUOTE_API_BASE_URL，
# 浏览器用 NEXT_PUBLIC_QUOTE_API_BASE_URL；见 apps/quote/README.md）。
# QUOTE_API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_QUOTE_API_BASE_URL=http://localhost:3000
# T-001 以图找样的 imageUrl 变体：允许服务端取图的对象存储 / CDN 域名（逗号分隔）。
# 留空表示禁用 URL 变体（移动端真找样需配置）；本地 MinIO 可写 localhost。
# MEDIA_ALLOWED_HOSTS=cdn.weaveorder.cn,localhost
# MEDIA_MAX_BYTES=2000000
# LLM 网关（LiteLLM）；智能体只认这个地址
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev
# 每租户虚拟 Key 的引用：llm_settings.key_ref 填这个环境变量名（或 KMS key 名），
# 不在数据库/日志里落明文。未配置时回退 LITELLM_MASTER_KEY（仅本地）。
# LITELLM_TENANT_KEY_T_0001=
# LITELLM_TIMEOUT_MS=30000
# 真实模型 key（缺省时 LiteLLM 仍可启动，模型调用失败）
# DEEPSEEK_API_KEY=
# 桌面 Web（Next.js）：浏览器只调同源 /api，由 BFF 在服务端注入 Bearer（token 存 httpOnly Cookie）
API_PROXY_TARGET=http://localhost:3000
# NEXT_PUBLIC_DEMO_MODE=1          # 构建时启用 mock transport（默认只在 ?demo=1 时启用）
# Casdoor Web 应用（Authorization Code + PKCE）
CASDOOR_CLIENT_ID=weave-order-web
# CASDOOR_CLIENT_SECRET=           # 可选：Casdoor 机密客户端时由 /auth/callback 服务端换取
# DEV_AUTH_TOKEN=dev:demo:demo     # 本地 /auth/dev 写入的 token
# 移动端（Taro）构建时注入 API 地址
# TARO_APP_API_BASE=http://localhost:3000
# 第六步冷启动导入（pnpm seed）默认读 data/seed/customers.csv + samples.csv。
# 需要换来源时覆盖（相对路径基于仓库根目录）：
# IMPORT_XLSX=data/seed/weave-order-seed.xlsx   # 单工作簿（customers / samples 两个 sheet），优先于下面两项
# IMPORT_CUSTOMERS=data/seed/customers.csv
# IMPORT_SAMPLES=data/seed/samples.csv

# ───────────────────────── E4 平台总管理端（控制面） ─────────────────────────
# 控制面独立数据库：与租户业务库物理分离（不会复制任何业务数据）。
# pnpm platform:migrate 会在库不存在时自动 CREATE DATABASE，然后建 control schema。
PLATFORM_DATABASE_URL=postgres://weave:weave@localhost:5433/weave_platform
# 控制面 API（独立进程，默认 3002）；只连 PLATFORM_DATABASE_URL。
PLATFORM_AUTH_MODE=dev
# 生产必须 oidc，并使用独立 Casdoor 应用 weave-platform（强制 MFA、禁止社交登录）
# PLATFORM_AUTH_MODE=oidc
CASDOOR_PLATFORM_CLIENT_ID=weave-platform
CASDOOR_PLATFORM_AUDIENCE=weave-platform
# CASDOOR_PLATFORM_CLIENT_SECRET=
# CASDOOR_JWKS_URI=https://sso.wnbgj.com/.well-known/jwks
PLATFORM_REQUIRE_MFA=true
# 双人复核有效期 / break-glass 只读授权时长（上限 60 分钟）
PLATFORM_APPROVAL_TTL_MINUTES=60
PLATFORM_BREAK_GLASS_MINUTES=60
# 租户侧 billing 内核补录用量的服务密钥（与平台令牌二选一）
# PLATFORM_INGEST_KEY=change-me-ingest-key
# 平台控制台地址与允许来源
PLATFORM_PUBLIC_URL=http://localhost:3003
PLATFORM_CORS_ORIGIN=http://localhost:3003
# 控制台 BFF 读取控制面的服务端地址
PLATFORM_API_URL=http://localhost:3002
# 本地无 Casdoor 时的平台身份（生产构建绝不回退）
# DEV_PLATFORM_TOKEN=dev:owner
