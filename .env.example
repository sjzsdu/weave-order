# 本地默认值与 docker-compose.yml 一致；不需要 .env 也能跑。
# 需要覆盖时：cp .env.example .env
DATABASE_URL=postgres://weave:weave@localhost:5433/weave_order
# 网关业务连接：生产/OIDC 模式必填，必须用 weave_app（NOSUPERUSER / NOBYPASSRLS）；
# 缺省会拒绝启动。启动时还会断言当前角色不是 superuser / bypassrls。
# 本地 dev 不设则沿用 DATABASE_URL（owner），仅用于开发并打印告警。
# APP_DATABASE_URL=postgres://weave_app:weave_app@localhost:5433/weave_order
REDIS_URL=redis://localhost:6380
# ---- embedding / 语义找样（S3） ----
# local-stub（默认）：16 维 FNV 哈希，零 key、离线可跑，但**不携带语义**，
#   不参与语义检索（不会把哈希分数伪装成相似度）。
# dashscope-text-v3：通义 text-embedding-v3（1024 维，真实语义），需要 key。
EMBEDDING_PROVIDER=local-stub
# EMBEDDING_MODEL=text-embedding-v3
# 维度必须与 sample_text_embeddings.embedding vector(1024) 一致；改维度要同时改迁移。
# EMBEDDING_DIMENSION=1024
# OpenAI 兼容端点；默认直连通义（本地 LiteLLM 网关未收录 embedding 模型）。
# 网关收录后可改成 http://localhost:4000/v1，无需改代码。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 缺省回落到 DASHSCOPE_API_KEY。
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_MS=20000
# 失败重试总尝试次数（指数退避，3 次）；耗尽后接口 5xx，不回退哈希。
# EMBEDDING_MAX_ATTEMPTS=3
# 语义结果的最低 cosine；实测无关文本基线约 0.37–0.49。
# SEARCH_SEMANTIC_MIN_SCORE=0.5
# ---- 图像向量 / 以图找样（S4）----
# local-stub（默认）：16 维哈希，零 key 可跑，但**不携带视觉语义**；
#   响应里 semantic=false + reasons 带「演示模式」，不会冒充真图搜图。
# dashscope-qwen3-vl：通义多模态 qwen3-vl-embedding（真实视觉语义），需要 key。
IMAGE_EMBEDDING_PROVIDER=local-stub
# IMAGE_EMBEDDING_MODEL=qwen3-vl-embedding
# 列不定维，换维度只需新建同维度的 partial HNSW 索引（reindex:images --ensure-index）。
# IMAGE_EMBEDDING_DIMENSION=1024
# 注意：多模态用 DashScope **原生**端点，不是 OpenAI 兼容端点（兼容端点没有图像向量）。
# IMAGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 缺省回落到 DASHSCOPE_API_KEY。
# IMAGE_EMBEDDING_API_KEY=
# IMAGE_EMBEDDING_TIMEOUT_MS=20000
# IMAGE_EMBEDDING_MAX_ATTEMPTS=3
# 送模型前把图缩到长边多少像素（0=不缩）。实测 512px 与 1024px 分离度差 0.006（噪声内），
# 而 token 从 1024 降到 256、成本降 4 倍。
# IMAGE_EMBEDDING_MAX_EDGE=512
# 图-图阈值：实测同款异角度 0.89~0.96、最易混异款 0.61~0.69，0.75 能挡住异款。
# SEARCH_IMAGE_MIN_SIMILARITY=0.75
# 文-图阈值：实测正确配对 0.35~0.57。图-图与文-图不是同一分布，必须分开配。
# SEARCH_IMAGE_TEXT_MIN_SIMILARITY=0.35
# 图向量不可用时是否退回「视觉模型描述 → 文本检索」。默认关：宁可明确报错。
# CAPTION_FALLBACK=false
# CAPTION_MODEL=qwen3-vl-plus
# CAPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 智能体 providers（默认本地确定性实现，无需任何外部 key）
# litellm = 经 LiteLLM 网关调用真实模型（token 自动计量）；local-rule = 零 key 规则实现
LLM_PROVIDER=local-rule
LOGISTICS_PROVIDER=local-deterministic
REPLY_SOURCE=local-scripted
PORT=3000
NODE_ENV=development
# 鉴权：dev = 接受 `Bearer dev:<sub>:<org>`（仅本地）；oidc = Casdoor JWKS 验签。
# 生产环境必须 AUTH_MODE=oidc，否则进程拒绝启动。
# 注意：AUTH_MODE=oidc 即使 NODE_ENV=development 也按「生产态」校验——本地连 staging SSO
# 需要同时配齐 PUBLIC_APP_URL / WEB_APP_URL（https 且非 localhost）、S3_FORCE_PATH_STYLE=false、
# PLATFORM_API_URL、NOTIFY_PROVIDER=webhook + NOTIFY_WEBHOOK_URL 以及相关 secret/S3 凭证，
# 否则进程拒绝启动。只想本地跑 UI 时继续用 AUTH_MODE=dev。
AUTH_MODE=dev
# 租户会话（WAN-81）：登录后选中的公司存在这里，tenant_id 只从服务端会话来。
# auto = AUTH_MODE=dev 用进程内会话，其余用 Redis；多实例部署必须是 redis。
SESSION_STORE=auto
# 会话有效期（秒，滑动续期）；默认 7 天。
SESSION_TTL_SECONDS=604800
CASDOOR_ISSUER=https://sso.wnbgj.com
CASDOOR_AUDIENCE=weave-order
# CASDOOR_JWKS_URI=https://sso.wnbgj.com/.well-known/jwks
# 客户报价分享链接的站点根地址（E3，Next.js 客户页，本地 5174）
PUBLIC_APP_URL=http://localhost:5174
# 报价链接 HMAC 密钥：生产必须换成 ≥32 字节随机值（openssl rand -hex 32）。
# 轮换会让所有已发出的链接立即失效。
QUOTE_SHARE_SECRET=dev-only-quote-share-secret-change-me-0001
# 出站通知（邀请链接、试用到期提醒）：log = 只记日志不发；webhook = POST 给自建网关，
# 由网关去调邮件/短信服务商。请求体：{ channel: "email"|"sms", to, subject?, text }。
# 生产/OIDC 模式必须 webhook + NOTIFY_WEBHOOK_URL，否则拒绝启动（log 等于提醒永远发不出去）。
NOTIFY_PROVIDER=log
# NOTIFY_WEBHOOK_URL=https://notify.internal/send
# NOTIFY_TOKEN=
# 新公司默认每月 credits（1 credit = 1,000 tokens），会写进该租户的 LLM 月度预算。
DEFAULT_MONTHLY_CREDITS=20000
# 控制面地址：自助开通的公司要在这里登记试用订阅（不配则不登记，本地单机模式；
# 生产/OIDC 模式必填且不能指向本机，否则拒绝启动）。
# PLATFORM_API_URL=http://localhost:3002
# 开通链接（客户老板领取公司空间）的 HMAC 密钥。
# 控制面（platform-api）签发、租户端（api）验签，两边必须完全一致；生产必须覆盖，
# 否则任何人都能伪造一条开通链接自建公司空间。轮换会让未使用的开通链接失效。
ONBOARDING_SECRET=dev-only-onboarding-secret-change-me-0001
# 打印代理 token 的 HS256 密钥：生产必须换成 ≥32 字节随机值（openssl rand -hex 32）。
PRINT_AGENT_SECRET=dev-only-print-agent-secret-change-me-0001
# 服务端 A4 PDF 中文字体（TTF/OTF；TTC 不支持）。缺省用 apps/api/assets/fonts 内置字体。
# PRINT_CJK_FONT_PATH=/usr/share/fonts/truetype/your-font.ttf
# 可选：headless Chromium 路径。只有需要「自定义 HTML 模板的精确 PDF」时才安装并显式配置；
# 不配置时走内置 A4 版式（仍然能打，但不是模板的像素级还原），且不会自动探测系统 Chrome。
# PRINT_CHROME_PATH=/usr/bin/chromium
# Next.js 客户页读取 API 的地址（服务端 SSR 用 QUOTE_API_BASE_URL，
# 浏览器用 NEXT_PUBLIC_QUOTE_API_BASE_URL；见 apps/quote/README.md）。
# QUOTE_API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_QUOTE_API_BASE_URL=http://localhost:3000
# T-001 以图找样的 imageUrl 变体：允许服务端取图的对象存储 / CDN 域名（逗号分隔）。
# MEDIA_BASE_URL 的主机会自动加入白名单；这里只需补历史域名 / 额外 CDN。
# MEDIA_ALLOWED_HOSTS=cdn.weaveorder.cn,localhost
# 本地对象存储（docker compose --profile media 或 scripts/dev-storage-up.sh）：
# 拉不到 Docker Hub 时可用镜像站覆盖 compose 镜像地址。
# MINIO_IMAGE=registry.example.com/minio/minio:RELEASE.2025-07-23T15-54-02Z
# MC_IMAGE=registry.example.com/minio/mc:RELEASE.2025-07-21T05-28-08Z
# 单张图片体积上限（上传与按 URL 取图共用），默认 10MB。
# MEDIA_MAX_BYTES=10485760
# 手工录入客户回复的原始 payload 保留天数（合规默认 30 天）。
# 到期后由定时任务 `pnpm --filter @weave-order/api maintain:inbound` 清空 raw_payload，
# 业务行、已脱敏正文与时间线都保留。
# INBOUND_RAW_RETENTION_DAYS=30
# ---- 对象存储（S3 兼容）----
# 本地默认连 docker compose 的 MinIO（bucket 由 minio-init 自动创建并开放匿名读）。
# 生产走腾讯云 COS：S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com，
# S3_FORCE_PATH_STYLE=false，MEDIA_BASE_URL 填 CDN 域名（桶不公开时可留空，改用签名 URL）。
# 生产/OIDC 模式必须显式配置 S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY，否则拒绝启动。
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=weave-media
# S3_ACCESS_KEY_ID=weave-media
# S3_SECRET_ACCESS_KEY=weave-media-secret
# S3_FORCE_PATH_STYLE=true
# MEDIA_BASE_URL=http://localhost:9000/weave-media
# MEDIA_PRESIGN_TTL_SECONDS=600
# LLM 网关（LiteLLM）；智能体只认这个地址
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev
# 每租户虚拟 Key 的引用：llm_settings.key_ref 填这个环境变量名（或 KMS key 名），
# 不在数据库/日志里落明文。未配置时回退 LITELLM_MASTER_KEY（仅本地）。
# LITELLM_TENANT_KEY_T_0001=
# LITELLM_TIMEOUT_MS=30000
# 真实模型 key（缺省时 LiteLLM 仍可启动，模型调用失败）
# DEEPSEEK_API_KEY=
# 桌面 Web（Next.js）：浏览器只调同源 /api，由 BFF 在服务端注入 Bearer（token 存 httpOnly Cookie）
API_PROXY_TARGET=http://localhost:3000
# NEXT_PUBLIC_DEMO_MODE=1          # 构建时启用 mock transport（默认只在 ?demo=1 时启用）
# 官网地址与支持邮箱：登录页的「申请开通」「帮助中心」「返回官网」都指向这里。
# 上线时把官网地址改成正式域名（站点在 site/，见 site/README.md）。
# NEXT_PUBLIC_MARKETING_URL=https://weaveorder.cn
# 支持邮箱（前端展示，点一下就是 mailto；不配则不显示邮箱，只提示联系管理员）。
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@weaveorder.cn
# 支持邮箱（服务端，用于试用到期等通知文案）。
# SUPPORT_EMAIL=hello@weaveorder.cn
# 访问统计（WAN-111）：cookieless，只发匿名事件与转化事件，不采集邮箱/手机号。
# provider 留空或 none 时前后端都完全静默，不发任何第三方请求。
# 工作台（apps/web）：运行时经 /config.js 下发给浏览器，不进构建产物；
# 换环境只改这几个变量并重启容器，不需要重新构建。
ANALYTICS_PROVIDER=                 # plausible | posthog | 留空
# ANALYTICS_DOMAIN=weave.wnbgj.com  # Plausible 统计的站点域名（PostHog 不需要）
# ANALYTICS_HOST=https://plausible.io # 自建时替换，例如 https://stats.weaveorder.cn
# ANALYTICS_KEY=                    # PostHog project key（phc_ 开头），Plausible 留空
# 官网（apps/site）：容器启动时由 docker/entrypoint.sh 渲染进页面，见 apps/site/README.md。
# WEAVE_ANALYTICS_PROVIDER=plausible
# WEAVE_ANALYTICS_DOMAIN=weaveorder.cn
# WEAVE_ANALYTICS_HOST=https://plausible.io
# WEAVE_ANALYTICS_KEY=
# Casdoor Web 应用（Authorization Code + PKCE）
CASDOOR_CLIENT_ID=weave-order-web
# CASDOOR_CLIENT_SECRET=           # 可选：Casdoor 机密客户端时由 /auth/callback 服务端换取
# DEV_AUTH_TOKEN=dev:demo:demo     # 本地 /auth/dev 写入的 token
# seed/demo 身份：7 个角色由 packages/schema/src/personas.ts 统一定义，
# `pnpm seed` 幂等写入；本地 dev 用 ⌘⇧I 切换（Owner 也对应 dev:demo:demo）。
# SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
# SEED_ORG=demo
# 移动端（Taro）构建时注入 API 地址
# TARO_APP_API_BASE=http://localhost:3000
# 第六步冷启动导入（pnpm seed）默认读 data/seed/customers.csv + samples.csv。
# 需要换来源时覆盖（相对路径基于仓库根目录）：
# IMPORT_XLSX=data/seed/weave-order-seed.xlsx   # 单工作簿（customers / samples 两个 sheet），优先于下面两项
# IMPORT_CUSTOMERS=data/seed/customers.csv
# IMPORT_SAMPLES=data/seed/samples.csv

# ───────────────────────── E4 平台总管理端（控制面） ─────────────────────────
# 控制面独立数据库：与租户业务库物理分离（不会复制任何业务数据）。
# pnpm platform:migrate 会在库不存在时自动 CREATE DATABASE，然后建 control schema。
PLATFORM_DATABASE_URL=postgres://weave:weave@localhost:5433/weave_platform
# 控制面 API（独立进程，默认 3002）；只连 PLATFORM_DATABASE_URL。
PLATFORM_AUTH_MODE=dev
# 生产必须 oidc，并使用独立 Casdoor 应用 weave-platform（强制 MFA、禁止社交登录）
# PLATFORM_AUTH_MODE=oidc
CASDOOR_PLATFORM_CLIENT_ID=weave-platform
CASDOOR_PLATFORM_AUDIENCE=weave-platform
# CASDOOR_PLATFORM_CLIENT_SECRET=
# CASDOOR_JWKS_URI=https://sso.wnbgj.com/.well-known/jwks
PLATFORM_REQUIRE_MFA=true
# 双人复核有效期 / break-glass 只读授权时长（上限 60 分钟）
PLATFORM_APPROVAL_TTL_MINUTES=60
PLATFORM_BREAK_GLASS_MINUTES=60
# 租户侧 billing 内核补录用量的服务密钥（与平台令牌二选一）
# PLATFORM_INGEST_KEY=change-me-ingest-key
# 平台控制台地址与允许来源。PLATFORM_PUBLIC_URL 同时是平台端 OIDC 的回跳域名，
# 生产必须配置成公网域名（缺失时平台端登录回跳直接报错，不回退到容器内部地址）。
PLATFORM_PUBLIC_URL=http://localhost:3003
PLATFORM_CORS_ORIGIN=http://localhost:3003
# 控制台 BFF 读取控制面的服务端地址
PLATFORM_API_URL=http://localhost:3002
# 本地无 Casdoor 时的平台身份（生产构建绝不回退）
# DEV_PLATFORM_TOKEN=dev:owner

# 个人访问凭据 / CLI 登录（WAN-78）
# PAT 哈希的 pepper；生产必须覆盖（openssl rand -hex 32）
PERSONAL_TOKEN_PEPPER=dev-only-personal-token-pepper-change-me-0001
# 租户端 Web 也要注入与 API 相同的 AUTH_MODE：web 与 api 共用 isProductionLike()
# （@weave-order/schema），它决定 Secure cookie、缺令牌是否放行、/auth/dev 是否关闭、
# 演示模式是否可用。AUTH_MODE=oidc 时即使 NODE_ENV=development（staging）也按生产态处理。
# AUTH_MODE=dev
# 租户端 Web 的公网地址（容器内注入）：既是 CLI 登录确认页与邀请链接的落点，
# 也是 OIDC 登录/回调的回跳域名（apps/web 与 platform-api 读的是同一个变量）。
# 生产必须配置成公网域名；缺失时租户端登录回跳直接报错，不再回退到容器内部地址。
WEB_APP_URL=http://localhost:3001
# CLI 登录确认码有效期与轮询间隔（秒）
DEVICE_CODE_TTL_SECONDS=600
DEVICE_POLL_INTERVAL_SECONDS=5
