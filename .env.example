# 本地默认值与 docker-compose.yml 一致；不需要 .env 也能跑。
# 需要覆盖时：cp .env.example .env
DATABASE_URL=postgres://weave:weave@localhost:5433/weave_order
REDIS_URL=redis://localhost:6380
# embedding：local-stub 无需外部 key；真实 provider 接入后在此切换
EMBEDDING_PROVIDER=local-stub
# 智能体 providers（默认本地确定性实现，无需任何外部 key）
LLM_PROVIDER=local-rule
LOGISTICS_PROVIDER=local-deterministic
REPLY_SOURCE=local-scripted
PORT=3000
NODE_ENV=development
# 第六步冷启动导入（pnpm seed）默认读 data/seed/customers.csv + samples.csv。
# 需要换来源时覆盖（相对路径基于仓库根目录）：
# IMPORT_XLSX=data/seed/weave-order-seed.xlsx   # 单工作簿（customers / samples 两个 sheet），优先于下面两项
# IMPORT_CUSTOMERS=data/seed/customers.csv
# IMPORT_SAMPLES=data/seed/samples.csv

# 用户凭据 / CLI 登录（WAN-78）
# 对外地址：CLI 设备登录确认页链接基于它拼接（部署时改成真实域名）
PUBLIC_API_URL=http://localhost:3000
# token 哈希的额外密钥。生产环境必须覆盖，泄露数据库也无法离线穷举 token。
# 生成示例：openssl rand -hex 32
AUTH_TOKEN_PEPPER=weave-order-dev-pepper
# 是否强制所有请求携带凭据。NODE_ENV=production 时无论该值如何都强制。
AUTH_REQUIRED=false
# CLI 登录确认码有效期与轮询间隔（秒）
DEVICE_CODE_TTL_SECONDS=600
DEVICE_POLL_INTERVAL_SECONDS=5
