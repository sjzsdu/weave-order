{
  "name": "weave-order",
  "version": "0.0.0",
  "private": true,
  "description": "织序 WeaveOrder — 纺织贸易的智能体原生业务操作系统",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>@types/react": "19.3.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run build && eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @weave-order/db generate",
    "db:migrate": "turbo run migrate",
    "demo": "turbo run migrate && turbo run demo && turbo run demo:followup",
    "seed": "turbo run migrate && turbo run seed",
    "lint:only": "eslint .",
    "demo:followup": "turbo run demo:followup",
    "demo:quote": "turbo run demo:quote",
    "platform:migrate": "pnpm --filter @weave-order/control-db migrate",
    "platform:seed": "pnpm platform:migrate && pnpm --filter @weave-order/platform-api seed",
    "dev:platform": "pnpm --filter @weave-order/platform-api dev",
    "dev:admin": "pnpm --filter @weave-order/admin dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
