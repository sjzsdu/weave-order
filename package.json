{
  "name": "weave-order",
  "version": "0.0.0",
  "private": true,
  "description": "织序 WeaveOrder — 纺织贸易的智能体原生业务操作系统",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>@types/react": "19.3.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:list": "node scripts/dev.mjs --list",
    "dev:cli": "pnpm --filter @weave-order/cli dev",
    "dev:desktop": "pnpm --filter @weave-order/print-agent dev",
    "test:scripts": "node --test scripts/dev.test.mjs scripts/test-env.test.mjs scripts/verify_release_version.test.mjs scripts/build-version.test.mjs",
    "lint": "turbo run build && node scripts/lint.mjs",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "test": "turbo run test",
    "verify:prod-env": "pnpm --filter @weave-order/api verify:prod-env",
    "verify:release": "node scripts/verify_release_version.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @weave-order/db generate",
    "db:migrate": "turbo run migrate",
    "db:repair": "pnpm --filter @weave-order/db migrate:repair",
    "db:check": "pnpm --filter @weave-order/db migrate:check",
    "db:backfill-owner": "pnpm --filter @weave-order/api backfill:owner",
    "demo": "turbo run migrate && turbo run demo && turbo run demo:followup",
    "seed": "turbo run migrate && turbo run seed",
    "lint:only": "node scripts/lint.mjs",
    "demo:followup": "turbo run demo:followup",
    "demo:quote": "turbo run demo:quote",
    "demo:reset": "node scripts/demo-reset.mjs",
    "platform:migrate": "pnpm --filter @weave-order/control-db migrate",
    "platform:seed": "pnpm platform:migrate && pnpm --filter @weave-order/platform-api seed",
    "dev:platform": "pnpm --filter @weave-order/platform-api dev",
    "dev:admin": "pnpm --filter @weave-order/admin dev",
    "cli": "pnpm --filter @weave-order/cli dev",
    "e2e": "node scripts/e2e.mjs",
    "e2e:test": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
